# Copy this file to .env, then fill every empty secret before starting.
# Required: use a long, randomly generated database password without URI-reserved characters.
POSTGRES_PASSWORD=

# Required: generate these independently; each value must contain at least 32 bytes.
CURSOR_SECRET=
SESSION_COOKIE_SECRET=

# Required when WEB_ENABLED=true: public HTTP(S) origin without a path, query, or fragment.
GITHUB_APP_PUBLIC_BASE_URL=

# Use false for direct localhost HTTP. Set true when users connect through HTTPS.
SESSION_COOKIE_SECURE=false

# Required: choose a local administrator password of at least 12 characters.
LOCAL_ADMIN_PASSWORD=

# Non-secret local deployment defaults.
LOCAL_ADMIN_TENANT_ID=local
LOCAL_ADMIN_OWNER_ID=local-admin
LOCAL_ADMIN_OWNER_EMAIL=admin@local
OAUTH_ISSUER=http://agentguild.local
OAUTH_AUDIENCE=agentguild

# Local dev: use the fixed-pass stub benchmark executor (evaluation evidence is
# marked executor=fixed-stub in run summaries). Set to "platform" to publish one
# real platform task per benchmark task and let the evaluation harvest worker
# score the results (executor=platform). Leave unset to disable
# evaluation runs entirely (fail closed with evaluation_unavailable).
EVALUATION_EXECUTOR=fixed

# Automatically start an evaluation run against the tenant's active benchmark
# set whenever a new draft agent version is created (requires EVALUATION_EXECUTOR).
EVALUATION_AUTO=false

# Platform executor timing: published evaluation task deadline, harvest worker
# interval, and overall run timeout.
EVALUATION_TASK_DEADLINE=2h
EVALUATION_WORKER_INTERVAL=30s
EVALUATION_RUN_TIMEOUT=24h

# Public GitHub Issue analysis. The default keeps the deterministic analyzer.
# Set PUBLIC_TASK_ANALYZER=openai to use an OpenAI-compatible endpoint.
PUBLIC_TASK_ANALYZER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
BASE_URL=https://dev.modelspub.com/v1
MODEL=gpt-5.6-sol
PUBLIC_TASK_ANALYSIS_TIMEOUT=90s
PUBLIC_TASK_ANALYSIS_MAX_FILES=120
PUBLIC_TASK_ANALYSIS_MAX_BYTES=524288
