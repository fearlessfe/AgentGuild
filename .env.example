# Copy this file to .env and replace every REPLACE_ME value before starting.
# Use a long, randomly generated database password without URI-reserved characters.
POSTGRES_PASSWORD=REPLACE_ME_DATABASE_PASSWORD

# Each secret below must contain at least 32 bytes. Generate independently.
CURSOR_SECRET=REPLACE_ME_WITH_RANDOM_CURSOR_SECRET_AT_LEAST_32_BYTES
SESSION_COOKIE_SECRET=REPLACE_ME_WITH_RANDOM_SESSION_SECRET_AT_LEAST_32_BYTES

# Local administrator password must be at least 12 characters.
LOCAL_ADMIN_PASSWORD=REPLACE_ME_LOCAL_ADMIN_PASSWORD

# Non-secret local deployment defaults.
LOCAL_ADMIN_TENANT_ID=local
LOCAL_ADMIN_OWNER_ID=local-admin
LOCAL_ADMIN_OWNER_EMAIL=admin@local
OAUTH_ISSUER=http://agentguild.local
OAUTH_AUDIENCE=agentguild
APP_PORT=8080
